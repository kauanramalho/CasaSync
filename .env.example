POSTGRES_USER=casasync
POSTGRES_PASSWORD=casasync
POSTGRES_DB=casasync
POSTGRES_PORT=5432

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://casasync:casasync@db:5432/casasync
JWT_SECRET_KEY=troque-esta-chave-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Em producao, defina FRONTEND_URL com a URL publica do frontend.
# CORS_ORIGINS aceita JSON ou lista separada por virgulas para origens adicionais.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=[]
CORS_ORIGIN_REGEX=^https://casa-sync(?:-[a-z0-9-]+)*\.vercel\.app$

TWO_FACTOR_CODE_TTL_MINUTES=10
TWO_FACTOR_PENDING_TOKEN_EXPIRE_MINUTES=15
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_RESEND_COOLDOWN_SECONDS=60
TWO_FACTOR_MAX_SENDS_PER_HOUR=5
TWO_FACTOR_LOGIN_INTERVAL_DAYS=30
TWO_FACTOR_HMAC_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM="CasaSync <no-reply@casasync.app>"
# Test-only fallback: logs the 2FA code instead of requiring SMTP.
# In Render, use EMAIL_DEV_MODE=true only temporarily for controlled validation.
EMAIL_DEV_MODE=true

# Frontend Vite. Em producao use a URL publica do backend, com ou sem /api.
# Exemplo: https://casasync-api.onrender.com/api
VITE_API_URL=http://localhost:8000/api

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_DEFAULT_TIMEZONE=America/Sao_Paulo
GOOGLE_CALENDAR_DEFAULT_EVENT_MINUTES=60

AI_PROVIDER=mock
AI_API_KEY=
AI_IMAGE_ANALYSIS_ENABLED=true
AI_VISION_ENABLED=false
AI_VISION_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_VISION_TIMEOUT_SECONDS=20
OPENAI_VISION_MAX_OUTPUT_TOKENS=1200
